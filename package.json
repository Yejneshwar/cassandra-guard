{
  "name": "cassandra-guard",
  "version": "1.2.0",
  "description": "Schema registry, CQL builder, migration diffing, and CLI for Cassandra",
  "license": "MIT",
  "author": "Yejneshwar Sivamoorthy",
  "homepage": "https://github.com/yejneshwar/cassandra-guard#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/yejneshwar/cassandra-guard"
  },
  "bugs": {
    "url": "https://github.com/yejneshwar/cassandra-guard/issues"
  },
  "keywords": [
    "cassandra",
    "cql",
    "schema",
    "migration",
    "guard",
    "query-builder",
    "ddl",
    "schema-registry",
    "database",
    "nosql",
    "introspection"
  ],
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "csg": "src/cli.js"
  },
  "files": [
    "src/",
    "schemas/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/**/*.test.js",
    "test:unit": "node --test tests/CQLBuilder.test.js tests/DDLAndMigration.test.js tests/SchemaRegistry.test.js",
    "test:integration": "node --test tests/integration.test.js",
    "docker:up": "node -e \"require('child_process').execSync(process.platform==='win32'?'powershell -File scripts/cassandra-up.ps1':'bash scripts/cassandra-up.sh',{stdio:'inherit'})\"",
    "docker:down": "node -e \"require('child_process').execSync(process.platform==='win32'?'powershell -File scripts/cassandra-down.ps1':'bash scripts/cassandra-down.sh',{stdio:'inherit'})\"",
    "validate": "node src/cli.js validate",
    "diff": "node src/cli.js diff",
    "migrate": "node src/cli.js migrate",
    "prepublishOnly": "npm run test:unit"
  },
  "dependencies": {
    "cassandra-driver": "^4.7.2",
    "commander": "^12.1.0",
    "ajv": "^8.17.1"
  },
  "devDependencies": {},
  "engines": {
    "node": ">=18.0.0"
  }
}
